{
  "format_on_save": "on",
  "formatter": {
    "language_server": {
      "name": "oxfmt"
    }
  },
  "code_actions_on_format": {
    "source.organizeImports": false
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-ls", "oxfmt", "oxlint"]
    },
    "JavaScript": {
      "language_servers": ["typescript-ls", "oxfmt", "oxlint"]
    }
  },
  "lsp": {
    "oxlint": {
      "binary": {
        "ignore_system_version": true,
        "path": "~/.local/share/mise/shims/oxlint",
        "arguments": ["--lsp"]
      }
    }
  },
  "file_types": {
    "env": [".env*"]
  }
}
